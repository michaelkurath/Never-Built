{% assign selected = selected_entry %}

{% if selected %}
  {% assign name_length = selected.name | size %}
  {% assign caption_length = selected.caption | size %}

  {% assign compact_name_size = "title--large lg:title--xxlarge" %}
  {% assign full_name_size = "title--xlarge lg:title--xxlarge" %}
  {% if name_length > 20 %}
    {% assign compact_name_size = "title--base lg:title--xlarge" %}
    {% assign full_name_size = "title--large lg:title--xlarge" %}
  {% endif %}
  {% assign compact_caption_size = "description--large lg:description--xlarge" %}
  {% if caption_length > 80 %}
    {% assign compact_caption_size = "description--base lg:description--large" %}
  {% endif %}
  {% assign quadrant_name_size = "title--large lg:title--xlarge" %}
  {% if name_length > 18 %}
    {% assign quadrant_name_size = "title--base lg:title--large" %}
  {% endif %}
  {% if name_length > 28 %}
    {% assign quadrant_name_size = "title--small lg:title--base" %}
  {% endif %}
{% endif %}

{% capture never_built_mark %}
  <svg class="w--[20px] h--[20px] shrink-0" viewBox="0 0 64 64" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round">
      <path d="M10 54V30L32 10L54 30V54Z" stroke-dasharray="7 5"/>
      <path d="M24 54V38H40V54M6 58H58"/>
    </g>
  </svg>
{% endcapture %}
