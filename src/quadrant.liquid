{% if selected %}
<div class="layout layout--col layout--stretch">
  <div class="p--2 lg:p--3 flex flex--col flex--between gap--xsmall w--full h--full">
    <div class="flex flex--row flex--between flex--center-y gap--small shrink-0">
      <span class="label lg:label--base">PROPOSED</span>
      <span class="label label--outline lg:label--base">{{ selected.stage | upcase }}</span>
    </div>
    <div class="flex flex--row flex--center-x w--full shrink-0">
      <div class="h--[56px] lg:h--[112px] lg:portrait:h--[128px] w--full rounded">
        <img class="image image--contain image-dither rounded w--full h--full" src="{{ selected.image_url_wide | default: selected.image_url }}" alt="{{ selected.image_alt }}">
      </div>
    </div>
    <div class="flex flex--col gap--xsmall w--full shrink-0">
      <span class="title {{ quadrant_name_size }}" data-clamp="2">{{ selected.name }}</span>
      <span class="description description--base lg:description--large font--bold" data-clamp="2" data-clamp-lg="3">{{ selected.caption }}</span>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <span class="title title--large lg:title--xlarge">No exhibit data</span>
</div>
{% endif %}

<div class="title_bar">
  <span class="title flex flex--row flex--center-y gap--xsmall">{{ never_built_mark }} NEVER BUILT</span>
  <span class="instance 1bit:text--black">{% if selected %}{{ selected.proposal_year }}{% else %}Offline{% endif %}</span>
</div>

